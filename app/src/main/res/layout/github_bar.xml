<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.08" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.92" />

        <Button
            android:id="@+id/btnGitInit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/uncutsans_bold"
            android:text="init repo"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            app:cornerRadius="0dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@+id/guidelineStart"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnGitStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/uncutsans_bold"
            android:text="git status"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            app:cornerRadius="0dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnGitInit" />

        <Button
            android:id="@+id/btnGitAddAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/uncutsans_bold"
            android:text="add all changes"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            app:cornerRadius="0dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnGitStatus" />

        <Button
            android:id="@+id/btnGitCommit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/uncutsans_bold"
            android:text="commit"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            app:cornerRadius="0dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnGitAddAll" />

        <Button
            android:id="@+id/btnGitPush"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/uncutsans_bold"
            android:text="push"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            app:cornerRadius="0dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnGitCommit" />

        <Button
            android:id="@+id/btnGitAddRemote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/uncutsans_bold"
            android:text="add remote"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            app:cornerRadius="0dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnGitPush" />

        <Button
            android:id="@+id/btnGitClone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/uncutsans_bold"
            android:text="clone repo"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            app:cornerRadius="0dp"
            app:layout_constraintEnd_toStartOf="@+id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@+id/guidelineStart"
            app:layout_constraintTop_toBottomOf="@+id/btnGitAddRemote" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
